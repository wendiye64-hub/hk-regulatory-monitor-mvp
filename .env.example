# Data source strategy:
# - static: bundled crawler JSON only (default for GitHub/GitLab Pages)
# - api: backend first; use in-memory demo data if it is unavailable
# - hybrid: backend first, then bundled crawler JSON, then demo data
VITE_DATA_MODE=static

# Optional backend API. Set this together with VITE_DATA_MODE=api or hybrid.
# VITE_API_BASE_URL=https://api.example.com/v1

# API request timeout in milliseconds
VITE_API_TIMEOUT_MS=5000

# Evidence research endpoint is public configuration, never a secret.
# Local direct mode only: http://127.0.0.1:8000
# A saved URL overrides this value only in local direct mode.
# Leave empty to keep the offline demo matrix. Never put an API key here (VITE_* is public).
VITE_RESEARCH_API_URL=

# Monitor CLI options (export to the terminal; Vite does not pass these to scripts).
# OPENAI_API_KEY is optional and only read by the Node monitor, never put it in VITE_*.
# Actions: use the OPENAI_API_KEY repository secret, not a checked-in .env.
# OPENAI_MODEL=gpt-5-mini
# BACKFILL=true
# BACKFILL_LIMIT=10
# BACKFILL_URLS=https://official.example/existing-notice
# TRIAGE_CONCURRENCY=4
# MAX_ENRICH_ITEMS=12
# MAX_DASHBOARD_ITEMS=120
# SYNC_DIST=false

# Pages production: public Worker URL only. No secrets in VITE_*.
# The Actions workflow forces gateway mode; missing URL locks research, never uses demo answers.
# Local direct API/demo: leave both empty.
VITE_RESEARCH_GATEWAY_URL=
VITE_RESEARCH_ACCESS_MODE=
